<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Deliberately NOT sandboxed: the app's entire job is to spawn the `mo`
         binary and read filesystem sizes across the whole disk. A sandbox would
         block both. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
